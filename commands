# Экспорт в ГИТ
# 1. Собрать все изменения в проектe
git remote add origin https://github.com/KarpeyevGS/TimeLineManager.git

git add .

# 2. Создать локальное "сохранение" с описанием
git commit -m "Краткое описание того, что сделал"

git push -u origin dev

# Импортировать из ГИТ
git checkout dev
git fetch origin
git reset --hard origin/dev


# 4. Проверка
git status

# frontend run 
cd frontend

npm run dev

npm run dev -- --host

